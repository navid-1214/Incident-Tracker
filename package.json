{
  "name": "incident-tracker-network-customer",
  "version": "16.3.0",
  "description": "Network and Customer Tracking System",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "electron .",
    "build:setup": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.asiatech.incidenttracker",
    "productName": "Network and Customer Tracking System",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "style.css",
      "app.js",
      "manifest.json",
      "sw.js",
      "assets/**/*",
      "electron-main.cjs"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Incident-Tracker-Network-Customer-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
